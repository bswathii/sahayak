# Sahayak — server configuration. Copy to .env and edit. Never commit .env.
PORT=3000
HOST=0.0.0.0

# SQLite database file (directory is created automatically)
DATABASE_PATH=./data/sahayak.db

# AI provider selection. Only "gemini" and "none" are implemented.
# AI_ENABLED is the runtime kill-switch: set to false to disable all AI calls
# without deleting the key (used for the Checkpoint-2 / Section 10 demonstration).
AI_PROVIDER=gemini
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=8000

# Log format: json (default, structured) or pretty (human readable)
LOG_FORMAT=json
LOG_LEVEL=info

# Optional: application-level payload cap experiment (Section 6E).
# 0 disables the cap. This throttles Sahayak payload, not the network.
PAYLOAD_CAP_BPS=0

# --- Qwen AI Provider (Section 4) ---
# DASHSCOPE_API_KEY — secret API key from Qwen/DashScope account.
# Set AI_PROVIDER=qwen to activate the Qwen provider.
# The key must remain on the backend; never commit it or expose it in client code.
DASHSCOPE_API_KEY=

# Qwen endpoint region. Adjust per your Qwen account/setup.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1

# Configurable model identifier. Must match an model your Qwen account accesses.
QWEN_MODEL=qwen-max

# Request timeout in milliseconds. Sensible default 8000 ms.
QWEN_TIMEOUT_MS=8000
